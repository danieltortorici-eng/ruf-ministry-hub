{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ruf-hub-ai-rate-limiter",
  "main": "worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "AI_RATE_LIMITER", "class_name": "AiRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AiRateLimiter"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
